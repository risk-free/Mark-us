    "bullmq": "^5.81.5",
    "dotenv": "^16.6.1",
    "ioredis": "^5.11.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "fflate": "^0.8.2",
    "jest": "^29.7.0",
    "postgres": "^3.4.5",
    "testcontainers": "^12.2.1",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
