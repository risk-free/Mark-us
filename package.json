{
  "name": "mark-us",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "contract:lint": "node scripts/lint-contract.mjs",
    "check:node": "node scripts/check-node-baseline.mjs",
    "db:generate": "pnpm --filter @markus/db generate",
    "db:validate": "pnpm --filter @markus/db validate",
    "db:build-migration": "pnpm --filter @markus/db build-migration",
    "db:drift": "pnpm --filter @markus/db test",
    "db:migrate": "pnpm --filter @markus/db migrate",
    "db:deploy": "pnpm --filter @markus/db migrate:deploy"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.26",
    "globals": "^15.15.0",
    "turbo": "^2.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1",
    "yaml": "^2.7.0"
  },
  "engines": {
    "node": ">=22"
  }
}
