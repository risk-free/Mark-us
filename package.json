{
  "name": "mark-us",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "check:supply-chain": "node scripts/check-supply-chain.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "eval": "pnpm --filter @markus/eval test",
    "contract:lint": "node scripts/lint-contract.mjs",
    "check:node": "node scripts/check-node-baseline.mjs",
    "db:generate": "pnpm --filter @markus/db generate",
    "db:validate": "pnpm --filter @markus/db validate",
    "db:build-migration": "pnpm --filter @markus/db build-migration",
    "db:drift": "pnpm --filter @markus/db test",
    "db:migrate": "pnpm --filter @markus/db migrate",
    "db:deploy": "pnpm --filter @markus/db migrate:deploy"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "globals": "^15.15.0",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.29",
      "sprintf-js": "^1.1.3",
      "deepmerge-ts": "^8.0.0",
      "glob@>=10.2.0 <10.5.0": "10.5.0"
    },
    "auditConfig": {
      "ignore": {
        "braces": [
          "GHSA-vfj7-8cjw-p6xm"
        ],
        "sprintf-js": [
          "GHSA-hp3w-g68c-fv3c"
        ]
      }
    }
  }
}
