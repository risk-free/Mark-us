// Mark-US data model — authoritative schema (PRD v2.0 §5, DECISIONS D-09..D-14)
// Migration workflow: pnpm db:migrate -- <name>   (prisma migrate dev)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  MASTER_ADMIN
  EXPERT
  SALESPERSON
}

enum StaffStatus {
  ACTIVE
  DISABLED
}

enum ContactStatus {
  NEW
  QUALIFIED
  ONBOARDING
  ACTIVE
  DORMANT
}

enum LeadStatus {
  NEW
  ASSIGNED
  CONTACTED
  CONVERTED
  LOST
}

enum LeadStage {
  NEW
  ASSESSED
  PROPOSAL
  PAYMENT
  FILED
  REGISTERED
  AFTERSALE
}

enum Channel {
  WECOM_KF
  WECOM_CONTACT
  WEB_WIDGET
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum ConversationStatus {
  OPEN
  WAITING
  RESOLVED
  CLOSED
}

enum OrderStatus {
  DRAFT
  PENDING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  CANCELLED
}

enum LineKind {
  SERVICE_FEE
  USPTO_FEE
  OTHER
}

enum InvoiceStatus {
  ISSUED
  VOIDED
}

enum PaymentProvider {
  STRIPE
  PAYPAL
}

enum PaymentMethod {
  CARD
  APPLE_PAY
  GOOGLE_PAY
  ALIPAY
  WECHAT_PAY
  PAYPAL
}

enum PaymentStatus {
  REQUIRES_ACTION
  SUCCEEDED
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum TrademarkStatus {
  ASSESSING
  DRAFT
  FILED
  REGISTERED
  ABANDONED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  USPTO_ASSIGNED
  OFFICE_ACTION
  RESPONSE_FILED
  PUBLISHED
  REGISTERED
  ABANDONED
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ConsentKind {
  SESSION_ARCHIVE
  PIPL_PRIVACY
  MARKETING
}

enum DocKind {
  IDENTITY
  SPECIMEN
  POWER_OF_ATTORNEY
  CORRESPONDENCE
  OTHER
}

enum NotificationChannel {
  WECHAT
  EMAIL
  PORTAL
}

// ---------------------------------------------------------------------------
// Staff & access (D-01 credential vault, D-06 no self-registration)
// ---------------------------------------------------------------------------

model StaffUser {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String?
  role         Role        @default(SALESPERSON)
  status       StaffStatus @default(ACTIVE)
  locale       String      @default("zh-CN")
  timezone     String      @default("Asia/Hong_Kong")
  wecomUserid  String?     @unique
  lastLoginAt  DateTime?

  // USPTO credential vault (D-01): envelope-encrypted ciphertext only.
  // MFA/OTP seed is NEVER stored — attorneys complete MFA themselves.
  usptoUsername       String?
  usptoPasswordCipher Bytes?
  usptoKeyVersion     Int?
  usptoVaultUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedContacts      Contact[]           @relation("ContactOwner")
  assignedConversations Conversation[]      @relation("ConversationOwner")
  assignedLeads         Lead[]              @relation("LeadOwner")
  filedApplications     Application[]       @relation("ExpertFiled")
  uploadedVersions      DocumentVersion[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  consentRecords        ConsentRecord[]

  @@index([role, status])
}

// ---------------------------------------------------------------------------
// CRM: contacts, leads, conversations (D-06)
// ---------------------------------------------------------------------------

model Contact {
  id     String        @id @default(cuid())
  name   String
  email  String?       @unique
  phone  String?       @unique
  wechatAlias String?
  locale String        @default("zh-CN")
  tags   String[]      @default([])
  status ContactStatus @default(NEW)
  stage  LeadStage     @default(NEW)

  assignedSalespersonId String?
  assignedSalesperson   StaffUser? @relation("ContactOwner", fields: [assignedSalespersonId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trademarks     Trademark[]
  orders         Order[]
  payments       Payment[]
  conversations  Conversation[]
  leads          Lead[]
  documents      Document[]
  tickets        CSTicket[]
  wecomLinks     WeComLink[]
  consentRecords ConsentRecord[]
  notifications  Notification[]

  @@index([assignedSalespersonId])
  @@index([stage])
}

model Lead {
  id     String     @id @default(cuid())
  source String
  tags   String[]   @default([])
  status LeadStatus @default(NEW)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  assignedSalespersonId String?
  assignedSalesperson   StaffUser? @relation("LeadOwner", fields: [assignedSalespersonId], references: [id])

  convertedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([assignedSalespersonId])
  @@index([status])
}

model Conversation {
  id       String             @id @default(cuid())
  channel  Channel
  status   ConversationStatus @default(OPEN)
  sentiment String?
  resolved Boolean            @default(false)
  archived Boolean            @default(false)
  lastMessageAt DateTime?

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])

  assignedSalespersonId String?
  assignedSalesperson   StaffUser? @relation("ConversationOwner", fields: [assignedSalespersonId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@index([contactId])
  @@index([assignedSalespersonId])
  @@index([status])
}

model Message {
  id             String           @id @default(cuid())
  direction      MessageDirection
  contentType    String           @default("text")
  content        String
  wecomMsgid     String?
  createdAt      DateTime         @default(now())

  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model WeComLink {
  id             String   @id @default(cuid())
  externalUserId String   @unique
  channel        Channel
  verifiedAt     DateTime?
  createdAt      DateTime @default(now())

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])

  @@index([contactId])
}

// ---------------------------------------------------------------------------
// IP & filings
// ---------------------------------------------------------------------------

model Trademark {
  id          String          @id @default(cuid())
  title       String
  description String?
  imageText   String?         // design element — word-mark-first scope (D-02)
  niceClass   Int
  goodsServices String

  status          TrademarkStatus @default(ASSESSING)
  filingBasis     String?
  serialNumber    String?         @unique
  registrationNumber String?      @unique
  filedAt         DateTime?
  registeredAt    DateTime?

  // Probability model (D-03): P(eventual registration), non-probabilistic sub-signals
  probabilityScore        Float?
  probabilityModelVersion String?
  probabilityReviewedAt   DateTime?

  // USPTO corpus (D-02): index status of this mark in our local index
  corpusStatus String?

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications Application[]
  documents    Document[]
  orders       Order[]

  @@index([contactId])
  @@index([niceClass])
  @@index([status])
}

model Application {
  id             String            @id @default(cuid())
  serialNumber   String?           @unique
  status         ApplicationStatus @default(DRAFT)
  filingBasis    String?
  filedAt        DateTime?
  responseDeadline DateTime?
  nextReminderAt DateTime?
  tsdrLastSyncAt DateTime?

  trademarkId String
  trademark   Trademark @relation(fields: [trademarkId], references: [id])

  expertAssignedId String?
  expertAssigned   StaffUser? @relation("ExpertFiled", fields: [expertAssignedId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  officeActions OfficeAction[]

  @@index([status])
  @@index([nextReminderAt])
  @@index([expertAssignedId])
}

model OfficeAction {
  id                String   @id @default(cuid())
  kind              String // NON_FINAL | FINAL | SUSPENSION | ...
  usptoActionCode   String?
  issuedAt          DateTime?
  responseDeadline  DateTime?
  bodyText          String?  // extracted via ODP/OCR
  analysis          Json?    // LLM draft + attorney review result
  responseFiledAt   DateTime?

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
  @@index([responseDeadline])
}

// ---------------------------------------------------------------------------
// Documents (D-09 — versioned, OCR + proofreading in Phase 2)
// ---------------------------------------------------------------------------

model Document {
  id             String   @id @default(cuid())
  filename       String
  kind           DocKind  @default(OTHER)
  currentVersion Int      @default(1)

  contactId String
  contact   Contact   @relation(fields: [contactId], references: [id])
  trademarkId String?
  trademark   Trademark? @relation(fields: [trademarkId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions DocumentVersion[]

  @@index([contactId])
  @@index([trademarkId])
}

model DocumentVersion {
  id             String   @id @default(cuid())
  versionNo      Int
  storageKey     String
  sizeBytes      Int
  checksum       String
  ocrText        String?
  proofreadStatus String? // PENDING | NEEDS_REVISION | APPROVED
  uploadedById   String?
  uploadedBy     StaffUser? @relation(fields: [uploadedById], references: [id])
  createdAt      DateTime @default(now())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNo])
}

// ---------------------------------------------------------------------------
// Commerce (D-05: itemized invoices, multi-rail payments)
// ---------------------------------------------------------------------------

model Order {
  id       String      @id @default(cuid())
  number   String      @unique
  status   OrderStatus @default(DRAFT)
  currency String      @default("USD")
  subtotal Decimal     @default(0) @db.Decimal(12, 2)
  total    Decimal     @default(0) @db.Decimal(12, 2)

  contactId String
  contact   Contact    @relation(fields: [contactId], references: [id])
  trademarkId String?
  trademark   Trademark? @relation(fields: [trademarkId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems InvoiceLineItem[]
  invoice   Invoice?
  payments  Payment[]

  @@index([contactId])
  @@index([status])
}

model InvoiceLineItem {
  id          String   @id @default(cuid())
  description String
  kind        LineKind @default(SERVICE_FEE)
  unitAmount  Decimal  @db.Decimal(12, 2)
  quantity    Int      @default(1)
  refundable  Boolean  @default(true)
  sortOrder   Int      @default(0)

  orderId String
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Invoice {
  id       String        @id @default(cuid())
  number   String        @unique
  locale   String        @default("zh-CN")
  status   InvoiceStatus @default(ISSUED)
  pdfKey   String?
  issuedAt DateTime      @default(now())
  paidAt   DateTime?
  createdAt DateTime     @default(now())

  orderId String  @unique
  order   Order   @relation(fields: [orderId], references: [id])
}

model Payment {
  id       String        @id @default(cuid())
  amount   Decimal       @db.Decimal(12, 2)
  currency String        @default("USD")
  provider PaymentProvider
  method   PaymentMethod
  status   PaymentStatus @default(REQUIRES_ACTION)

  transactionId   String? @unique // provider charge/payout id
  providerEventId String? @unique // webhook idempotency key
  rawEvent        Json?
  paidAt          DateTime?
  refundedAt      DateTime?

  orderId String?
  order   Order?    @relation(fields: [orderId], references: [id])
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([contactId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Service ops: tickets, notifications, audit, consent (D-07/D-10/D-12)
// ---------------------------------------------------------------------------

model CSTicket {
  id                String       @id @default(cuid())
  type              String // STATUS | TIMELINE | INVOICE | OTHER
  status            TicketStatus @default(OPEN)
  severity          Severity     @default(MEDIUM)
  description       String
  resolution        String?
  resolvedAt        DateTime?
  satisfactionScore Int?
  slaDueAt          DateTime?

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
  @@index([status, slaDueAt])
}

model Notification {
  id       String              @id @default(cuid())
  channel  NotificationChannel
  template String
  payload  Json?
  status   String              @default("PENDING") // PENDING | SENT | FAILED
  sentAt   DateTime?
  createdAt DateTime           @default(now())

  userId String?
  user   StaffUser? @relation(fields: [userId], references: [id])
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  @@index([userId, status])
  @@index([contactId])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String // VAULT_READ | ORDER_PAID | CASE_FILED | ROLE_CHANGED | ...
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  actorId String?
  actor   StaffUser? @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
}

model ConsentRecord {
  id        String      @id @default(cuid())
  kind      ConsentKind
  granted   Boolean
  evidence  String?
  ip        String?
  createdAt DateTime    @default(now())

  staffId String?
  staff   StaffUser? @relation(fields: [staffId], references: [id])
  contactId String?
  contact   Contact?   @relation(fields: [contactId], references: [id])

  @@index([contactId, kind])
  @@index([staffId, kind])
}

// ---------------------------------------------------------------------------
// ERP (P7): marketing budget tracking
// ---------------------------------------------------------------------------

model Campaign {
  id      String   @id @default(cuid())
  name    String
  channel String
  budget  Decimal  @db.Decimal(12, 2)
  period  String // e.g. "2026-Q1"
  notes   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([period])
}
