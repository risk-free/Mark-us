# ---- Core ----
DATABASE_URL=postgresql://markus:markus@localhost:5432/markus
REDIS_URL=redis://localhost:6379
PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001
# Required (>= 32 chars). Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=

# ---- Runtime ----
NODE_ENV=development
PORT=3001
RUN_WORKER=0

# ---- Storage (R2 / S3) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_DOCUMENTS=
R2_BUCKET_INVOICES=

# ---- Encryption (USPTO credential vault, D-01) ----
KMS_KEY_ID=
# Local dev fallback ONLY — staging/production must use a KMS-wrapped data key
VAULT_MASTER_KEY=dev-only-not-for-prod

# ---- Payments (D-05) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASE_URL=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ---- WeCom (D-06) ----
WECOM_CORP_ID=
WECOM_CORP_SECRET=
WECOM_KF_TOKEN=
WECOM_ARCHIVE_KEY=
WECOM_CALLBACK_TOKEN=
WECOM_CALLBACK_AES_KEY=

# ---- USPTO (D-02) ----
TSDR_API_KEY=
USPTO_BULK_BASE_URL=https://data.uspto.gov
# Researcher product id for the anonymous signed-URL backfill (TRCFECO2)
USPTO_RESEARCHER_PRODUCT_ID=TRCFECO2
# Corpus freshness SLA in hours; /tm/search reports stale beyond this (M7.1)
TM_CORPUS_FRESHNESS_HOURS=26
# Nightly corpus ingest job in the worker (off by default; no full researcher download in dev)
TM_CORPUS_INGEST_ENABLED=false
# Firm USPTO account (vault rows in DB; MFA never stored)
USPTO_ASSISTED_LOGIN_ENABLED=false

# ---- Anonymous assessment (M8.1 / M8.2) ----
# 24 h result cache TTL for GET /tm/assess
TM_ASSESSMENT_CACHE_TTL_SECONDS=86400
# Rate limits for GET /tm/assess (per hour)
TM_ASSESS_RATE_IP_PER_HOUR=20
TM_ASSESS_RATE_MARK_PER_HOUR=5

# ---- LLM gateway (D-04) ----
LLM_PRIMARY_BASE_URL=
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
BGE_EMBED_URL=

# ---- Observability ----
SENTRY_DSN=
POSTHOG_HOST=
POSTHOG_KEY=
